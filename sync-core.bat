@echo off
rem Copies rentka-core\src into the app and the Cloud Functions.
rem Run this after every change in rentka-core\src. Never edit the copies.
setlocal
set "ROOT=%~dp0"
set "SRC=%ROOT%rentka-core\src"

call :sync "%ROOT%frontend\src\core"
if errorlevel 1 exit /b 1
call :sync "%ROOT%backend\functions\src\core"
if errorlevel 1 exit /b 1

echo Core synced to frontend\src\core and backend\functions\src\core.
exit /b 0

:sync
rem /MIR also removes files that were deleted from rentka-core\src. Robocopy codes below 8 mean success.
robocopy "%SRC%" "%~1" /MIR /NJH /NJS /NDL /NFL /NP /XF DO-NOT-EDIT.txt >nul
if errorlevel 8 (
  echo Sync to %~1 FAILED.
  exit /b 1
)
echo Generated by sync-core.bat. Edit rentka-core\src instead, then run sync-core.bat.> "%~1\DO-NOT-EDIT.txt"
exit /b 0
