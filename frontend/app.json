{
  "expo": {
    "name": "RentKa",
    "slug": "rentka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rentka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rentka.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7A4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "@react-native-firebase/app",
      [
        "expo-camera",
        {
          "cameraPermission": "RentKa uses the camera to scan your ID and take photos of items."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RentKa uses your location to match you with nearby items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RentKa lets you choose photos of your items.",
          "cameraPermission": "RentKa uses the camera to take photos of items."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}